ErrorDocument 404 /404.html
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Oude pagina's permanent doorsturen naar de drie nieuwe pagina's (behoud SEO-waarde, geen gebroken links)
RewriteRule ^diensten/(administratie-emailbeheer|sales-crm-klantenservice)/?$ /diensten-tarieven/#administratie-business-support [R=301,NE,L]
RewriteRule ^diensten/(executive-assistant|planning-coordinatie)/?$ /diensten-tarieven/#executive-operational-support [R=301,NE,L]
RewriteRule ^diensten/(reisorganisatie-reserveringen|hospitality-support)/?$ /diensten-tarieven/#travel-hospitality-support [R=301,NE,L]
RewriteRule ^diensten/?$ /diensten-tarieven/ [R=301,L]
RewriteRule ^tarieven/?$ /diensten-tarieven/#tarieven [R=301,NE,L]
RewriteRule ^contact(/bedankt)?/?$ /diensten-tarieven/#kennismaken [R=301,NE,L]
RewriteRule ^werkwijze/?$ / [R=301,L]
# Afsluitende slash voor mappen
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# HTML-pagina's altijd opnieuw controleren, zodat updates direct zichtbaar zijn
<IfModule mod_headers.c>
<FilesMatch "\.(html|php)$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
</IfModule>
